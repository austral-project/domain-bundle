{
  "name": "austral/domain-bundle",
  "type": "symfony-bundle",
  "description": "TODO: bundle description",
  "keywords": ["austral", "symfony", "bundle", "cms", "admin"],
  "homepage": "https://austral.dev",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    },
    {
      "name": "Austral contributors",
      "homepage": "https://github.com/austral-project/domain-bundle/graphs/contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/austral-project/domain-bundle/issues",
    "source": "https://github.com/austral-project/domain-bundle",
    "docs": "https://austral.dev",
    "security": "https://github.com/austral-project/.github/blob/master/SECURITY.md"
  },
  "require": {
    "php": ">=8.4",
    "austral/contracts": "^4.0",
    "austral/tools-bundle": "^4.0",
    "austral/entity-bundle": "^4.0",
    "austral/entity-file-bundle": "^4.0",
    "austral/http-bundle": "^4.0",
    "doctrine/collections": "^2.2 || ^3.1",
    "doctrine/orm": "^3.7",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2.2",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "gedmo/doctrine-extensions": "^3.0",
    "ramsey/uuid": "^4.9.1",
    "symfony/console": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/http-kernel": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5",
    "symfony/framework-bundle": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Austral\\DomainBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\DomainBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "check": [
      "@cs",
      "@phpstan",
      "@test"
    ]
  }
}
